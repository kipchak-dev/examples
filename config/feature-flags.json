{
    "version": 2,
    "features": [
        {
            "name": "new-checkout",
            "description": "On for customers on the pro plan, with the colour of the new checkout as a JSON payload",
            "enabled": true,
            "strategies": [
                {
                    "name": "flexibleRollout",
                    "parameters": {"rollout": "100", "stickiness": "default", "groupId": "new-checkout"},
                    "constraints": [{"contextName": "plan", "operator": "IN", "values": ["pro"]}],
                    "variants": [
                        {
                            "name": "blue",
                            "weight": 1000,
                            "weightType": "variable",
                            "stickiness": "default",
                            "payload": {"type": "json", "value": "{\"colour\": \"blue\"}"}
                        }
                    ]
                }
            ]
        },
        {
            "name": "beta-reports",
            "description": "Rolled out to half of all users, by user id",
            "enabled": true,
            "strategies": [
                {
                    "name": "flexibleRollout",
                    "parameters": {"rollout": "50", "stickiness": "userId", "groupId": "beta-reports"}
                }
            ]
        },
        {
            "name": "early-access",
            "description": "Gates GET /v1/beta: rolled out to half of all users, by user id (the API key's client)",
            "enabled": true,
            "strategies": [
                {
                    "name": "flexibleRollout",
                    "parameters": {"rollout": "50", "stickiness": "userId", "groupId": "early-access"}
                }
            ]
        },
        {
            "name": "kill-switch",
            "description": "Off",
            "enabled": false,
            "strategies": [{"name": "default"}]
        }
    ]
}
