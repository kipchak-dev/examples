{
    "name": "mamluk/kipchak-starter",
    "type": "template",
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "mamluk/kipchak": "^0.46"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "api/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
