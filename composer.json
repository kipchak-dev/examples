{
    "name": "kipchak/examples",
    "description": "Working examples of every free Kipchak driver and middleware",
    "type": "project",
    "homepage": "https://kipchak.dev",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "kipchak/core": "^3.15",
        "kipchak/driver-anthropic": "^2",
        "kipchak/driver-clickhouse": "^1.1",
        "kipchak/driver-cloudflare-dns": "^1",
        "kipchak/driver-cloudns": "^1",
        "kipchak/driver-couchdb": "^1",
        "kipchak/driver-doctrine": "^1",
        "kipchak/driver-feature-flags": "^1.0",
        "kipchak/driver-filecache": "^1",
        "kipchak/driver-git": "^1",
        "kipchak/driver-http": "^2",
        "kipchak/driver-logger": "^1",
        "kipchak/driver-memcached": "^1",
        "kipchak/driver-nats": "^1.0",
        "kipchak/driver-openai": "^2",
        "kipchak/driver-rabbitmq": "^1",
        "kipchak/driver-s3": "^1",
        "kipchak/driver-sftp": "^1.1",
        "kipchak/driver-vector": "^1.0",
        "kipchak/middleware-auth-jwks": "^1",
        "kipchak/middleware-auth-key": "^1",
        "kipchak/middleware-error": "^1",
        "kipchak/middleware-feature-flags": "^1.0",
        "kipchak/middleware-response-cache": "^1.0",
        "kipchak/middleware-subashi": "^1",
        "unleash/client": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "api/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
