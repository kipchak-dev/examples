{
    "name": "kipchak/starter",
    "type": "template",
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "kipchak/core": "2.x-dev",
        "kipchak/driver-couchdb": "dev-master",
        "kipchak/driver-memcached": "dev-master",
        "kipchak/driver-http": "dev-master",
        "kipchak/driver-filecache": "dev-master",
        "kipchak/driver-doctrine": "dev-master",
        "kipchak/driver-logger": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "api/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
