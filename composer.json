{
    "name": "kipchak/starter",
    "description": "Kipchak PHP API Development Kit (ADK) Starter Project",
    "type": "template",
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "kipchak/core": "^2",
        "kipchak/driver-couchdb": "^1",
        "kipchak/driver-memcached": "^1",
        "kipchak/driver-http": "^1",
        "kipchak/driver-filecache": "^1",
        "kipchak/driver-doctrine": "^1",
        "kipchak/driver-logger": "^1",
        "kipchak/driver-rabbitmq": "^1",
        "kipchak/driver-git": "^1",
        "kipchak/driver-s3": "^1",
        "kipchak/middleware-error": "^1",
        "kipchak/middleware-auth-key": "^1",
        "kipchak/middleware-auth-jwks": "^1",
        "kipchak/middleware-subashi": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "api/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
