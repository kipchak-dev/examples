#!/usr/bin/env php
<?php
use Doctrine\ORM\Tools\Console\ConsoleRunner;
use Doctrine\ORM\Tools\Console\EntityManagerProvider\SingleManagerProvider;
use Kipchak\Core\Api;
use Slim\App;
use Psr\Container\ContainerInterface;
use Kipchak\Driver\Config\Driver as Config;
use Kipchak\Driver\Doctrine\Driver as Doctrine;

require_once (realpath(__DIR__ . '/../vendor/autoload.php'));

/**
 * @var App $app
 */
$app = Api::bootCli();

/**
 * @var ContainerInterface $container
 */
$container = $app->getContainer();

$ems = Config::get('kipchak.doctrine')['orm']['entity_managers'];

$entityManagers = [];

$commands = [
    // If you want to add your own custom console commands,
    // you can do so here.
];

foreach ($ems as $name => $em) {
    ConsoleRunner::run(
            new SingleManagerProvider(Doctrine::get('entitymanager.' . $name), $name),
            $commands
    );
}

// Now entity managers can be run on the CLI via:
// php vendor/bin/doctrine orm:info --em primary (primary here being defined in kipchak.doctrine as an entity_manager in the orm section